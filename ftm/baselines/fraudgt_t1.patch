+@torch.no_grad()
+def _t1_dump(loaders, model):
+    """T1 patch: score EVERY edge of the val split (and of the test split only when T1_EVAL_TEST=1) with the best-val-F1 weights
+    and write T1_OUT/pred_<split>.csv: tx_id (= row of the raw CSV = ftm's tx_id), label, score (P(laundering), uncalibrated)."""
+    import json as _json, os as _os
+    import pandas as _pd
+    from fraudGT.head import hetero_edge as _he
+    out = _os.environ.get('T1_OUT', '.')
+    ck = torch.load(_os.path.join(out, 'best.pt'), map_location=cfg.device)
+    model.load_state_dict(ck['model'])
+    model.eval()
+    rows = _pd.read_csv(_os.path.join(cfg.dataset.dir, cfg.dataset.format, 'formatted_transactions.csv'),
+                        usecols=['EdgeID', 'Is Laundering'])
+    meta = {'best_epoch': ck['epoch'], 'best_val_f1': ck['val_f1']}
+    for split, wrapper in zip(['val', 'test'], loaders[1:]):
+        if split == 'test' and _os.environ.get('T1_EVAL_TEST') != '1':
+            continue  # the test loader reads val data (custom_sampler.py); test is scored only in the final run
+        torch.manual_seed(cfg.seed)  # neighbour sampling is random: fix it so the dump is reproducible
+        eids, labels, scores, skipped = [], [], [], 0
+        for batch in wrapper.loader:  # the full loader, not the iter_per_epoch-capped wrapper
+            batch.split = split
+            batch.to(torch.device(cfg.device))
+            try:
+                pred, true = model(batch)[:2]
+            except RuntimeError as e:
+                if "cannot sample n_sample <= 0 samples" not in str(e):
+                    raise
+                skipped += 1
+                continue
+            pred, true = pred.squeeze(-1), true.squeeze(-1)  # as in compute_loss: [n, 1] logits are the binary case
+            score = torch.softmax(pred, dim=-1)[:, 1] if pred.ndim > 1 else torch.sigmoid(pred)
+            eids.append(_he.T1_LAST_EID.cpu())
+            labels.append(true.cpu())
+            scores.append(score.float().cpu())
+        df = _pd.DataFrame({'row': torch.cat(eids).numpy(), 'label': torch.cat(labels).numpy(),
+                            'score': torch.cat(scores).numpy()}).drop_duplicates('row')
+        # the edge ids index the time-sorted formatted CSV; its labels must match the model's, else the mapping is wrong
+        assert (rows['Is Laundering'].to_numpy()[df['row']] == df['label']).all(), 'edge id -> CSV row mapping is wrong'
+        df.insert(0, 'tx_id', rows['EdgeID'].to_numpy()[df['row']])
+        df = df.drop(columns='row').sort_values('tx_id').reset_index(drop=True)
+        path = _os.path.join(out, f'pred_{split}.csv')
+        if _os.environ.get('T1_DUMP_ONLY') == '1' and _os.path.exists(path):  # final run: the stored val scores must reproduce
+            old = _pd.read_csv(path)
+            diff = float((old['score'] - df['score']).abs().max()) if old['tx_id'].equals(df['tx_id']) else float('inf')
+            meta[f'{split}_max_abs_diff'] = diff  # GPU scatter is not bit-exact: about 1e-4 between two identical dumps
+            assert diff < 1e-3, f'{path} does not reproduce (max abs diff {diff}): do not use these scores'
+        else:
+            df.to_csv(path, index=False)
+        meta[split] = {'n_scored': len(df), 'n_expected': len(wrapper.loader.dataset), 'skipped_batches': skipped}
+        logging.info(f"T1 dump {split}: {meta[split]}")
+    with open(_os.path.join(out, 'pred_meta.json'), 'w') as fh:
+        _json.dump(meta, fh, indent=1)
+
